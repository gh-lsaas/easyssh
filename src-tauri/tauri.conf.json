{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "easyssh",
  "version": "0.1.6",
  "identifier": "fi.eassh.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "easyssh",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src https://api.github.com ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "shortDescription": "SSH terminals and a built-in file editor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMUU3RjA3Njk0NTI5MTAKUldRUUtVVnBCMzhlMDBRKytubUtOREsxQmY3Vk9pb3ExNmd5K0oxOXNJazhpdnVWcWh6RnZMSnkK",
      "endpoints": [
        "https://github.com/gh-lsaas/easyssh/releases/latest/download/latest.json"
      ]
    }
  }
}
